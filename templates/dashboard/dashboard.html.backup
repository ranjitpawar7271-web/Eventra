{% extends 'base.html' %}

{% block title %}Dashboard{% endblock %}

{% block content %}

<div class="dashboard-layout">

    {% include 'includes/sidebar.html' %}

    <main class="dashboard-main">

        <!-- =====================================================
             WELCOME HEADER
             ===================================================== -->

        <div class="dashboard-welcome mb-4">

            <div class="dashboard-welcome-content">

                <div class="dashboard-welcome-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>
                    <p class="dashboard-eyebrow mb-1">
                        <i class="bi bi-stars me-1"></i>
                        Eventra Dashboard
                    </p>

                    <h2 class="dashboard-welcome-title mb-1">
                        Welcome back, {{ user.first_name|default:user.username }} 👋
                    </h2>

                    <div class="dashboard-welcome-meta">
                        <span class="badge-soft accent">
                            {{ user.get_role_display }}
                        </span>

                        <span class="dashboard-welcome-description">
                            Here's what's happening with your events today.
                        </span>
                    </div>
                </div>

            </div>

            {% if user.can_manage_events %}

            <a href="{% url 'events:event_create' %}"
               class="btn btn-primary dashboard-create-btn">

                <i class="bi bi-plus-circle me-2"></i>
                Create Event

            </a>

            {% endif %}

        </div>


        <!-- =====================================================
             SUPER ADMIN SYSTEM OVERVIEW
             ===================================================== -->

        {% if is_admin_view %}

        <section class="dashboard-section glass-card p-4 mb-4">

            <div class="dashboard-section-header">

                <div>
                    <span class="dashboard-section-kicker">
                        ADMINISTRATION
                    </span>

                    <h3 class="dashboard-section-title">
                        <i class="bi bi-shield-check text-accent me-2"></i>
                        System Overview
                    </h3>

                    <p class="dashboard-section-description">
                        Platform-wide events, finance and user statistics.
                    </p>
                </div>

                <div class="dashboard-section-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

            </div>


            <!-- Event Statistics -->

            <div class="dashboard-subsection">

                <div class="dashboard-subsection-title">
                    <i class="bi bi-calendar-event"></i>
                    Event Activity
                </div>

                <div class="row g-3">

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-calendar3"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_events }}</p>
                                <p class="stat-label">Total Events</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-broadcast"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_active_events }}</p>
                                <p class="stat-label">Active</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-calendar-week"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_upcoming_events }}</p>
                                <p class="stat-label">Upcoming</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-check-circle"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_completed_events }}</p>
                                <p class="stat-label">Completed</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-x-circle"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_cancelled_events }}</p>
                                <p class="stat-label">Cancelled</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-ticket-perforated"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_registrations }}</p>
                                <p class="stat-label">Confirmed Regs</p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>


            <!-- Admin Approval -->

            <div class="dashboard-admin-action mt-3">

                <div class="dashboard-admin-action-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>

                <div class="flex-grow-1">
                    <strong>Pending Approvals</strong>
                    <p class="mb-0 text-muted-custom small">
                        Events waiting for administrative approval.
                    </p>
                </div>

                <div class="dashboard-admin-action-value">
                    {{ sys_pending_approvals }}
                </div>

                <a href="{% url 'workflow:approval_list' %}"
                   class="btn btn-sm btn-primary">
                    Review
                </a>

            </div>


            <!-- Financial Statistics -->

            <div class="dashboard-subsection mt-4">

                <div class="dashboard-subsection-title">
                    <i class="bi bi-cash-stack"></i>
                    Financial Overview
                </div>

                <div class="row g-3">

                    <div class="col-sm-6 col-xl-3">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>

                            <div>
                                <p class="stat-value">₹{{ sys_total_revenue }}</p>
                                <p class="stat-label">Total Revenue</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-wallet2"></i>
                            </div>

                            <div>
                                <p class="stat-value">₹{{ sys_total_expenses }}</p>
                                <p class="stat-label">Total Expenses</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-cash-coin"></i>
                            </div>

                            <div>
                                <p class="stat-value">₹{{ sys_net_profit }}</p>
                                <p class="stat-label">Net Profit / Loss</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-truck"></i>
                            </div>

                            <div>
                                <p class="stat-value">₹{{ sys_vendor_payments }}</p>
                                <p class="stat-label">Vendor Payments</p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>


            <!-- User Statistics -->

            <div class="dashboard-subsection mt-4">

                <div class="dashboard-subsection-title">
                    <i class="bi bi-people"></i>
                    Platform Users
                </div>

                <div class="row g-3">

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_users }}</p>
                                <p class="stat-label">Total Users</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-person"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_participants }}</p>
                                <p class="stat-label">Participants</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-person-workspace"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_organizers }}</p>
                                <p class="stat-label">Organizers</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-person-badge"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_staff }}</p>
                                <p class="stat-label">Staff</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-truck"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_vendors }}</p>
                                <p class="stat-label">Vendors</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-2">
                        <div class="glass-card dashboard-stat-card">
                            <div class="icon-tile">
                                <i class="bi bi-heart"></i>
                            </div>

                            <div>
                                <p class="stat-value">{{ sys_total_volunteers }}</p>
                                <p class="stat-label">Volunteers</p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>


            <div class="dashboard-info-note mt-4">
                <i class="bi bi-info-circle"></i>

                <span>
                    Resource-utilization widgets light up once the Resource module is further along.
                    Approvals, notifications, and the shared calendar are live — see the card above
                    and the bell icon in the navbar.
                </span>
            </div>

        </section>

        {% endif %}


        <!-- =====================================================
             NOTIFICATIONS / APPROVALS
             ===================================================== -->

        {% if my_pending_approvals or my_unread_notifications %}

        <div class="dashboard-alert-bar glass-card mb-4">

            {% if my_pending_approvals %}

            <a href="{% url 'workflow:notification_list' %}"
               class="dashboard-alert-item">

                <i class="bi bi-hourglass-split"></i>

                <span>
                    {{ my_pending_approvals }}
                    event{{ my_pending_approvals|pluralize }}
                    awaiting approval
                </span>

            </a>

            {% endif %}


            {% if my_unread_notifications %}

            <a href="{% url 'workflow:notification_list' %}"
               class="dashboard-alert-item">

                <i class="bi bi-bell"></i>

                <span>
                    {{ my_unread_notifications }}
                    unread notification{{ my_unread_notifications|pluralize }}
                </span>

            </a>

            {% endif %}


            <a href="{% url 'workflow:calendar' %}"
               class="dashboard-alert-item">

                <i class="bi bi-calendar3"></i>

                <span>View Calendar</span>

            </a>

        </div>

        {% endif %}


        <!-- =====================================================
             MY EVENT OVERVIEW
             ===================================================== -->

        <section class="dashboard-section mb-4">

            <div class="dashboard-section-header">

                <div>
                    <span class="dashboard-section-kicker">
                        EVENT MANAGEMENT
                    </span>

                    <h3 class="dashboard-section-title">
                        <i class="bi bi-calendar-event text-accent me-2"></i>
                        My Event Overview
                    </h3>

                    <p class="dashboard-section-description">
                        A quick view of your events and participation.
                    </p>
                </div>

            </div>


            <div class="row g-3">

                <div class="col-sm-6 col-xl-3">
                    <div class="glass-card dashboard-stat-card dashboard-stat-highlight">
                        <div class="icon-tile">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ total_events }}</p>
                            <p class="stat-label">Total Events</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-3">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-tags"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ total_categories }}</p>
                            <p class="stat-label">Total Categories</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-3">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ total_participants }}</p>
                            <p class="stat-label">Total Participants</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-3">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ my_registrations_count }}</p>
                            <p class="stat-label">My Registrations</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-4">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-calendar-week"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ my_upcoming_count }}</p>
                            <p class="stat-label">My Upcoming Events</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-4">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ my_completed_count }}</p>
                            <p class="stat-label">My Completed Events</p>
                        </div>
                    </div>
                </div>


                <div class="col-sm-6 col-xl-4">
                    <div class="glass-card dashboard-stat-card">
                        <div class="icon-tile">
                            <i class="bi bi-x-circle"></i>
                        </div>

                        <div>
                            <p class="stat-value">{{ my_cancelled_count }}</p>
                            <p class="stat-label">My Cancelled Events</p>
                        </div>
                    </div>
                </div>

            </div>

        </section>


        <!-- =====================================================
             QUICK ACTIONS + UPCOMING EVENTS
             ===================================================== -->

        <div class="row g-4 mb-4">

            <!-- Quick Actions -->

            <div class="col-lg-4">

                <section class="dashboard-panel glass-card p-4 h-100">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-section-kicker">
                                SHORTCUTS
                            </span>

                            <h3 class="dashboard-panel-heading-title">
                                <i class="bi bi-lightning-charge text-accent me-2"></i>
                                Quick Actions
                            </h3>
                        </div>

                    </div>


                    <div class="d-grid gap-2">

                        {% if user.can_manage_events %}

                        <a href="{% url 'events:event_create' %}"
                           class="quick-action">

                            <i class="bi bi-plus-circle text-info"></i>

                            <span>Create Event</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>


                        <a href="{% url 'categories:category_create' %}"
                           class="quick-action">

                            <i class="bi bi-tag text-info"></i>

                            <span>Add Category</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>


                        <a href="{% url 'events:my_events' %}"
                           class="quick-action">

                            <i class="bi bi-calendar-check text-info"></i>

                            <span>Manage My Events</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>


                        <a href="{% url 'budget:budget_list' %}"
                           class="quick-action">

                            <i class="bi bi-cash-coin text-info"></i>

                            <span>Budgets & Expenses</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>


                        <a href="{% url 'reports:report_hub' %}"
                           class="quick-action">

                            <i class="bi bi-graph-up text-info"></i>

                            <span>Reports & Analytics</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>

                        {% endif %}


                        <a href="{% url 'events:my_registrations' %}"
                           class="quick-action">

                            <i class="bi bi-ticket-perforated text-info"></i>

                            <span>My Registrations</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>


                        <a href="{% url 'tickets:my_tickets' %}"
                           class="quick-action">

                            <i class="bi bi-qr-code text-info"></i>

                            <span>My Tickets</span>

                            <i class="bi bi-arrow-right ms-auto quick-action-arrow"></i>

                        </a>

                    </div>

                </section>

            </div>


            <!-- Upcoming Events -->

            <div class="col-lg-8">

                <section class="dashboard-panel glass-card p-4 h-100">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-section-kicker">
                                SCHEDULE
                            </span>

                            <h3 class="dashboard-panel-heading-title">
                                <i class="bi bi-calendar-week text-info me-2"></i>
                                Upcoming Events
                            </h3>
                        </div>

                        <a href="{% url 'events:event_list' %}"
                           class="dashboard-view-all">
                            View all
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>


                    {% if upcoming_events %}

                    <div class="table-responsive dashboard-table-wrapper">

                        <table class="table table-hover align-middle mb-0 dashboard-table">

                            <thead>

                                <tr>
                                    <th>Event</th>
                                    <th>Category</th>
                                    <th>Date</th>
                                </tr>

                            </thead>


                            <tbody>

                                {% for event in upcoming_events %}

                                <tr>

                                    <td>
                                        <a href="{{ event.get_absolute_url }}"
                                           class="dashboard-event-link">
                                            {{ event.title }}
                                        </a>
                                    </td>


                                    <td>

                                        {% if event.category %}

                                        <span class="badge-soft">
                                            {{ event.category.name }}
                                        </span>

                                        {% else %}

                                        <span class="text-muted-custom">—</span>

                                        {% endif %}

                                    </td>


                                    <td>
                                        <span class="dashboard-date">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            {{ event.start_date|date:"M d, Y" }}
                                        </span>
                                    </td>

                                </tr>

                                {% endfor %}

                            </tbody>

                        </table>

                    </div>

                    {% else %}

                    <div class="dashboard-empty-state">

                        <div class="dashboard-empty-icon">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                        <h4>No upcoming events</h4>

                        <p class="text-muted-custom mb-0">
                            There are no upcoming events to display right now.
                        </p>

                    </div>

                    {% endif %}

                </section>

            </div>

        </div>


        <!-- =====================================================
             RECENT ACTIVITY
             ===================================================== -->

        <div class="row g-4 mb-4">

            <!-- Recent Registrations -->

            <div class="col-lg-6">

                <section class="dashboard-panel glass-card p-4 h-100">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-section-kicker">
                                ACTIVITY
                            </span>

                            <h3 class="dashboard-panel-heading-title">
                                <i class="bi bi-person-lines-fill text-info me-2"></i>
                                Recent Registrations
                            </h3>
                        </div>

                    </div>


                    {% if recent_registrations %}

                    <ul class="list-unstyled dashboard-activity-list mb-0">

                        {% for reg in recent_registrations %}

                        <li class="dashboard-activity-item">

                            <div class="dashboard-activity-icon">
                                <i class="bi bi-person-check"></i>
                            </div>

                            <div class="dashboard-activity-content">

                                <p class="mb-0">
                                    {{ reg.user.get_full_name|default:reg.user.username }}
                                </p>

                                <p class="text-muted-custom mb-0 small">
                                    {{ reg.event.title }}
                                </p>

                            </div>

                            <span class="badge-soft success">
                                {{ reg.get_status_display }}
                            </span>

                        </li>

                        {% endfor %}

                    </ul>

                    {% else %}

                    <div class="dashboard-empty-state compact">

                        <div class="dashboard-empty-icon">
                            <i class="bi bi-person-x"></i>
                        </div>

                        <p class="text-muted-custom mb-0">
                            No registrations for your events yet.
                        </p>

                    </div>

                    {% endif %}

                </section>

            </div>


            <!-- Recent Events -->

            <div class="col-lg-6">

                <section class="dashboard-panel glass-card p-4 h-100">

                    <div class="dashboard-panel-heading">

                        <div>
                            <span class="dashboard-section-kicker">
                                ACTIVITY
                            </span>

                            <h3 class="dashboard-panel-heading-title">
                                <i class="bi bi-clock-history text-info me-2"></i>
                                Recent Events
                            </h3>
                        </div>

                    </div>


                    {% if recent_events %}

                    <ul class="list-unstyled dashboard-activity-list mb-0">

                        {% for event in recent_events %}

                        <li class="dashboard-activity-item">

                            <div class="dashboard-activity-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>

                            <div class="dashboard-activity-content">

                                <a href="{{ event.get_absolute_url }}">
                                    {{ event.title }}
                                </a>

                                <p class="text-muted-custom mb-0 small">
                                    {{ event.created_at|date:"M d, Y" }}
                                </p>

                            </div>


                            <span class="badge-soft
                                {% if event.status == 'published' %}
                                    success
                                {% elif event.status == 'cancelled' %}
                                    danger
                                {% else %}
                                    accent
                                {% endif %}">
                                {{ event.get_status_display }}
                            </span>

                        </li>

                        {% endfor %}

                    </ul>

                    {% else %}

                    <div class="dashboard-empty-state compact">

                        <div class="dashboard-empty-icon">
                            <i class="bi bi-calendar-x"></i>
                        </div>

                        <p class="text-muted-custom mb-0">
                            You haven't created any events yet.
                        </p>

                    </div>

                    {% endif %}

                </section>

            </div>

        </div>


        <!-- =====================================================
             BUDGET OVERVIEW
             ===================================================== -->

        {% if user.can_manage_events and has_budgets %}

        <section class="dashboard-section glass-card p-4 mb-4">

            <div class="dashboard-section-header">

                <div>

                    <span class="dashboard-section-kicker">
                        FINANCE
                    </span>

                    <h3 class="dashboard-section-title">
                        <i class="bi bi-cash-coin text-accent me-2"></i>
                        My Budgets
                    </h3>

                    <p class="dashboard-section-description">
                        Budget performance across your events.
                    </p>

                </div>


                <a href="{% url 'budget:budget_list' %}"
                   class="dashboard-view-all">

                    View all
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="row g-3">

                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-piggy-bank"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                ₹{{ my_estimated_budget }}
                            </p>

                            <p class="stat-label">
                                Estimated
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-wallet2"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                ₹{{ my_total_expenses }}
                            </p>

                            <p class="stat-label">
                                Spent
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                ₹{{ my_total_revenue }}
                            </p>

                            <p class="stat-label">
                                Revenue
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                ₹{{ my_profit_or_loss }}
                            </p>

                            <p class="stat-label">
                                Profit / Loss
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </section>

        {% endif %}


        <!-- =====================================================
             REGISTRATION & TICKETING
             ===================================================== -->

        {% if user.can_manage_events and has_registration_activity %}

        <section class="dashboard-section glass-card p-4">

            <div class="dashboard-section-header">

                <div>

                    <span class="dashboard-section-kicker">
                        REGISTRATION & TICKETING
                    </span>

                    <h3 class="dashboard-section-title">
                        <i class="bi bi-clipboard-data text-accent me-2"></i>
                        Registrations, Attendance & Ticketing
                    </h3>

                    <p class="dashboard-section-description">
                        Registration and ticket activity across your events.
                    </p>

                </div>

            </div>


            <div class="row g-3">

                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_reg_confirmed }}
                            </p>

                            <p class="stat-label">
                                Confirmed Registrations
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-x-circle"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_reg_cancelled }}
                            </p>

                            <p class="stat-label">
                                Cancelled Registrations
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_reg_waitlisted }}
                            </p>

                            <p class="stat-label">
                                Waitlisted
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-percent"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_attendance_rate }}%
                            </p>

                            <p class="stat-label">
                                Attendance Rate
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_tickets_generated }}
                            </p>

                            <p class="stat-label">
                                Tickets Generated
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-qr-code-scan"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_tickets_used }}
                            </p>

                            <p class="stat-label">
                                Tickets Used
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-ticket"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_tickets_unused }}
                            </p>

                            <p class="stat-label">
                                Tickets Unused
                            </p>
                        </div>

                    </div>

                </div>


                <div class="col-sm-6 col-xl-3">

                    <div class="glass-card dashboard-stat-card">

                        <div class="icon-tile">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <div>
                            <p class="stat-value">
                                {{ my_payments_successful }}
                            </p>

                            <p class="stat-label">
                                Successful Payments
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            {% if my_payments_pending or my_payments_failed or my_payments_refunded %}

            <div class="dashboard-payment-summary">

                {% if my_payments_pending %}
                <span>
                    <i class="bi bi-clock-history"></i>
                    {{ my_payments_pending }} pending
                </span>
                {% endif %}

                {% if my_payments_failed %}
                <span>
                    <i class="bi bi-exclamation-circle"></i>
                    {{ my_payments_failed }} failed
                </span>
                {% endif %}

                {% if my_payments_refunded %}
                <span>
                    <i class="bi bi-arrow-counterclockwise"></i>
                    {{ my_payments_refunded }} refunded
                </span>
                {% endif %}

            </div>

            {% endif %}

        </section>

        {% endif %}

    </main>

</div>

{% endblock %}